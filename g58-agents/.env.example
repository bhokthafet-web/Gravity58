NODE_ENV=production
PORT=8090
# Same database as G58 Core (copy POSTGRES_PASSWORD from /opt/g58-core-staging/.env).
DATABASE_URL=postgres://g58:CHANGE_ME@g58-postgres:5432/g58
G58_NETWORK=g58-core-staging_g58-private
PUBLIC_BASE_URL=https://server.g58.in/agents
SESSION_COOKIE=g58_session
TICK_SECONDS=300
TZ_NAME=Asia/Kolkata

# Email sending (same Brevo SMTP relay as G58 Core). MAIL_FROM must be a sender verified in Brevo,
# ideally on g58.in. Replies from businesses go to MAIL_REPLY_TO (your own inbox).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gravity58 <hello@g58.in>
MAIL_REPLY_TO=
UNSUBSCRIBE_SECRET=

# Claude API (optional: without it, emails are drafted from templates) (https://console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
USD_TO_INR=84

# WhatsApp Cloud API (Meta for Developers → your app → WhatsApp → API setup)
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_TEMPLATE_INTRO=g58_intro
WA_TEMPLATE_FOLLOWUP=g58_followup
WA_TEMPLATE_OWNER_REPORT=g58_owner_report
WA_TEMPLATE_LANG=en
WA_COST_PER_CONVERSATION_INR=0.8

# Your own WhatsApp number. Messages from it go to the coordinator; the daily report goes to it.
OWNER_WHATSAPP=

# Razorpay (Dashboard → Account & Settings → API keys / Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

OVERPASS_URL=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
