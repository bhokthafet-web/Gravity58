{
  email admin@g58.in
  admin off
}

server.g58.in {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }

  # G58 Agents dashboard, webhooks and website previews (g58-agents/ in this repo).
  redir /agents /agents/ 308
  handle_path /agents/* {
    reverse_proxy g58-agents:8090
  }

  handle {
    reverse_proxy api:8088
  }
}
